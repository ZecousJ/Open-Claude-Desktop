# /etc/claudex-runner/runner.env (mode 0600). Every setting is described at
# the top of runner/src/main.ts.

# The server, as the runner reaches it, and as browsers do when different.
CLAUDEX_RUNNER_SERVICE_URL=http://127.0.0.1:8080
CLAUDEX_RUNNER_PUBLIC_URL=https://claudex.example.com
# The token from the admin console's Runners page (shown once).
CLAUDEX_RUNNER_TOKEN_FILE=/etc/claudex-runner/token

CLAUDEX_RUNNER_STATE_DIR=/var/lib/claudex-runner
# Codex defaults to the @openai/codex package next to runner.mjs.

# gVisor sandboxes with per-user ext4 volumes; bwrap needs no sudo.
CLAUDEX_RUNNER_DRIVER=runsc
CLAUDEX_RUNNER_SUDO=1
CLAUDEX_RUNNER_DISK_QUOTA=loop
CLAUDEX_RUNNER_DISK_MB=5120
CLAUDEX_RUNNER_CPUS=1
CLAUDEX_RUNNER_PIDS=512
CLAUDEX_RUNNER_MEMORY_MB=1536

# Capacity and what this runner offers.
CLAUDEX_RUNNER_MAX_USERS=20
CLAUDEX_RUNNER_MAX_ENGINES=8
CLAUDEX_RUNNER_MODES=chat,cowork,code
CLAUDEX_RUNNER_LABELS=host=runner-1
