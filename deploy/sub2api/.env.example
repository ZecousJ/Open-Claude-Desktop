# Settings for the Claudex server stack (docker-compose.yml next to this file).
# Copy to .env (chmod 600) and replace every "change-me" value; the server
# refuses to start while a secret is still a change-me placeholder.
# Generate keys with:  openssl rand -hex 32
# Never commit the filled-in file.

# --- Claudex server image, built with deploy/claudex-server/build-image.sh ---
# Pin the version you built (and pushed or loaded), e.g. claudex-server:0.2.8-claudex.6
CLAUDEX_SERVER_IMAGE=claudex-server:change-me-version
# Loopback by default; the TLS reverse proxy on this host forwards to it.
BIND_HOST=127.0.0.1
CLAUDEX_SERVER_PORT=8080
# Affects "today", subscription and usage windows, and log timestamps.
TZ=Asia/Shanghai

# --- PostgreSQL ---
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=change-me-postgres-password

# --- Redis ---
REDIS_PASSWORD=change-me-redis-password

# --- First-start administrator (the person who will accept the compliance commitment) ---
ADMIN_EMAIL=change-me@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- Signing and encryption keys (64 hex chars each; keep them stable) ---
JWT_SECRET=change-me-openssl-rand-hex-32
TOTP_ENCRYPTION_KEY=change-me-openssl-rand-hex-32
# Sign-in (access) tokens expire after 60 minutes; the desktop app renews them
# with its refresh token (30 days by default).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Only used when JWT_ACCESS_TOKEN_EXPIRE_MINUTES is 0.
JWT_EXPIRE_HOUR=24

# --- Upstream URL allowlist (recommended once the upstream host is known) ---
SECURITY_URL_ALLOWLIST_ENABLED=false
# Comma-separated upstream hosts, used only when the allowlist is enabled.
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=true
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=true

# Optional outbound proxy for the model price data download.
UPDATE_PROXY_URL=
