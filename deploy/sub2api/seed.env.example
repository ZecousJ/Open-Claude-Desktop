# Inputs for seed-claudex.sh. Copy to seed.env (chmod 600); never commit it.
# Every value comes from the operator; the script has no built-in upstream,
# key or model.

# Public URL of the Claudex server (the reverse proxy, https in production).
SUB2API_URL=https://claudex.example.com
# Admin console -> Settings -> Admin API key (generate it after accepting the
# compliance commitment). Sent as x-api-key. Not needed for --dry-run.
SUB2API_ADMIN_API_KEY=

# --- Upstream account (a provider you are licensed to use with an API key) ---
CLAUDEX_UPSTREAM_NAME=claudex-upstream
# Sub2API account/group platform. Claudex's gateway speaks the OpenAI Responses
# and Chat Completions protocols, which Sub2API serves on "openai" groups.
CLAUDEX_UPSTREAM_PLATFORM=openai
CLAUDEX_UPSTREAM_BASE_URL=https://upstream.example.com
CLAUDEX_UPSTREAM_API_KEY=
CLAUDEX_UPSTREAM_CONCURRENCY=3
CLAUDEX_UPSTREAM_PRIORITY=1
# true = replace the stored key on an existing account (otherwise it is kept).
CLAUDEX_UPSTREAM_ROTATE_KEY=false

# --- Models ---
# Comma-separated exact names Claudex users may call (the group allowlist).
CLAUDEX_MODELS=
# Defaults to the first of CLAUDEX_MODELS.
CLAUDEX_DEFAULT_MODEL=
# Optional renames sent upstream: requested=upstream,requested2=upstream2
CLAUDEX_MODEL_MAPPING=

# --- Pricing in USD per million tokens (Sub2API stores it per token) ---
CLAUDEX_PRICE_INPUT_USD_PER_MTOK=
CLAUDEX_PRICE_OUTPUT_USD_PER_MTOK=
CLAUDEX_PRICE_CACHE_READ_USD_PER_MTOK=
CLAUDEX_PRICE_CACHE_WRITE_USD_PER_MTOK=
CLAUDEX_CHANNEL_NAME=claudex-pricing

# --- Plan groups ---
# Pay-as-you-go group billed from the user's balance.
CLAUDEX_STANDARD_GROUP=claudex-standard
CLAUDEX_STANDARD_RATE_MULTIPLIER=1
# Subscription plan. An empty limit means unlimited for that window; the
# weekly window rolls 7x24h from the subscription's window start.
CLAUDEX_PLAN_GROUP=claudex-pro
CLAUDEX_PLAN_DESCRIPTION=Claudex subscription plan
CLAUDEX_PLAN_RATE_MULTIPLIER=1
CLAUDEX_PLAN_DAILY_USD=
CLAUDEX_PLAN_WEEKLY_USD=
CLAUDEX_PLAN_MONTHLY_USD=

# --- Public settings Claudex reads from GET /api/v1/settings/public ---
CLAUDEX_SITE_NAME=Claudex
CLAUDEX_SITE_SUBTITLE=
# closed | open | invite (invite = registration with invitation codes)
CLAUDEX_REGISTRATION=closed
# true needs working SMTP settings in the admin console.
CLAUDEX_EMAIL_VERIFY=

# --- Optional test user with a subscription to the plan group ---
CLAUDEX_TEST_USER_EMAIL=
CLAUDEX_TEST_USER_PASSWORD=
CLAUDEX_TEST_USER_CONCURRENCY=3
CLAUDEX_TEST_USER_DAYS=30
