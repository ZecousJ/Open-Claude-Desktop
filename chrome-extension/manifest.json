{
  "manifest_version": 3,
  "name": "Claudex in Chrome",
  "version": "0.1.0",
  "description": "Share the current tab with Claudex on this computer.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Share this tab with Claudex"
  }
}
