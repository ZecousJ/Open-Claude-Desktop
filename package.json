{
  "name": "claudex-desktop",
  "productName": "Claudex",
  "desktopName": "claudex.desktop",
  "version": "0.0.38",
  "private": true,
  "description": "Claude-inspired desktop workspace powered by the open-source Codex agent",
  "author": "Claudex contributors",
  "homepage": "https://github.com/ZecousJ/Open-Claude-Desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZecousJ/Open-Claude-Desktop.git"
  },
  "bugs": "https://github.com/ZecousJ/Open-Claude-Desktop/issues",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "build:web": "tsc --noEmit -p tsconfig.web.json && node scripts/check-web-imports.mjs && vite build -c vite.web.config.ts && node scripts/check-web-bundle.mjs",
    "dev:web": "vite -c vite.web.config.ts",
    "check:web": "node scripts/check-web-imports.mjs && node scripts/check-web-bundle.mjs",
    "start": "electron .",
    "test": "tsx --import ./tests/support/css-stub.mjs --test-timeout=120000 --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "test:engine": "tsx scripts/smoke-engine.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"shared/**/*.ts\" \"runner/src/**/*.ts\" \"server/**/*.ts\" \"src-web/**/*.{ts,tsx}\" \"tests/**/*.{ts,mts,mjs}\" \"scripts/**/*.{ts,mts,mjs,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"shared/**/*.ts\" \"runner/src/**/*.ts\" \"server/**/*.ts\" \"src-web/**/*.{ts,tsx}\" \"tests/**/*.{ts,mts,mjs}\" \"scripts/**/*.{ts,mts,mjs,tsx}\"",
    "package": "npm run build && node scripts/prepare-runtime.mjs && node scripts/computer-use/fetch-driver.mjs && electron-builder --publish never",
    "package:mac": "npm run build && node scripts/prepare-runtime.mjs && node scripts/computer-use/fetch-driver.mjs darwin && electron-builder --mac zip --publish never && node -e \"require('fs').rmSync('release/mac-arm64',{recursive:true,force:true})\"",
    "package:win": "npm run build && node scripts/prepare-runtime.mjs win32 x64 && node scripts/computer-use/fetch-driver.mjs win32 x64 && electron-builder --win nsis --x64 --publish never",
    "icons": "electron scripts/build-icons.mjs",
    "build:mobile-conversation": "tsc --noEmit -p tsconfig.web.json && vite build -c vite.mobile-conversation.config.ts && node scripts/check-mobile-conversation.mjs",
    "test:mobile-conversation": "node --import tsx --test tests/mobile-conversation.test.ts && node scripts/mobile-conversation/run-effects-tests.mjs",
    "package:linux": "npm run build && node scripts/prepare-runtime.mjs linux x64 && node -e \"require('fs').mkdirSync('build/computer-use',{recursive:true})\" && electron-builder --linux deb rpm tar.gz --x64 --publish never && node scripts/prepare-runtime.mjs linux arm64 && electron-builder --linux deb rpm tar.gz --arm64 --publish never && node -e \"for (const d of ['release/linux-unpacked','release/linux-arm64-unpacked']) require('fs').rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@iarna/toml": "^2.2.5",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "^6.0.0",
    "fuse.js": "7.4.0",
    "jszip": "^3.10.2",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.3",
    "mermaid": "^12.0.0",
    "pdfjs-dist": "^6.3.289",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sucrase": "^3.35.1",
    "undici": "^7.30.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@openai/codex": "0.144.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.4.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.3",
    "linkedom": "^0.18.12",
    "prettier": "3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "dev.claudex.desktop",
    "productName": "Claudex",
    "protocols": [
      {
        "name": "Claudex",
        "schemes": [
          "claudex"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/**/*",
      "!backend{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "codex"
      },
      {
        "from": "build/CODEX-NOTICE.txt",
        "to": "codex/NOTICE.txt"
      },
      {
        "from": "dist-server",
        "to": "provider-service"
      },
      {
        "from": "build/computer-use",
        "to": "computer-use"
      },
      {
        "from": "build/icon.iconset/icon_32x32.png",
        "to": "tray-icon.png"
      },
      {
        "from": "build/tray-iconTemplate.png",
        "to": "tray-iconTemplate.png"
      },
      {
        "from": "build/tray-iconTemplate@2x.png",
        "to": "tray-iconTemplate@2x.png"
      },
      {
        "from": "build/icon.iconset/icon_128x128@2x.png",
        "to": "about-icon.png"
      },
      {
        "from": "scripts/configure-backend.mjs",
        "to": "operator/configure-backend.mjs"
      }
    ],
    "asarUnpack": [
      "dist-electron/quick-access-monitor",
      "dist-electron/notification-authorization.node"
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Claudex uses the microphone only while you record a dictation for the message composer."
      },
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Claudex-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true,
    "toolsets": {
      "nsis": "1.2.1"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "executableName": "claudex",
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "Claudex contributors <https://github.com/ZecousJ/Open-Claude-Desktop>",
      "vendor": "Claudex",
      "synopsis": "Claudex desktop",
      "description": "Claudex desktop app: chat, Cowork and Code.",
      "artifactName": "Claudex-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "Claudex",
          "Keywords": "AI;chat;code;"
        }
      }
    },
    "deb": {
      "artifactName": "claudex_${version}_${arch}.deb",
      "packageName": "claudex"
    },
    "rpm": {
      "artifactName": "claudex-${version}.${arch}.rpm",
      "packageName": "claudex"
    }
  }
}
