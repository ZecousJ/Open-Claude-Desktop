{
  "name": "claudex-desktop",
  "productName": "Claudex",
  "desktopName": "claudex.desktop",
  "version": "0.0.64",
  "private": true,
  "description": "Claude-inspired desktop workspace powered by the open-source Codex agent",
  "author": "Claudex contributors",
  "homepage": "https://github.com/ZecousJ/Open-Claude-Desktop",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prepare:document-runtime": "node scripts/prepare-document-runtime.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "build:web": "node scripts/prepare-workspace-ui.mjs && tsc --noEmit -p tsconfig.web.json && node scripts/check-web-imports.mjs && vite build -c vite.official-web.config.ts",
    "dev:web": "node scripts/prepare-workspace-ui.mjs && vite -c vite.official-web.config.ts",
    "check:web": "node scripts/check-web-imports.mjs && node scripts/check-web-bundle.mjs",
    "start": "electron .",
    "test": "tsx --import ./tests/support/css-stub.mjs --test-timeout=120000 --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "test:engine": "tsx scripts/smoke-engine.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"shared/**/*.ts\" \"runner/src/**/*.ts\" \"server/**/*.ts\" \"src-web/**/*.{ts,tsx}\" \"tests/**/*.{ts,mts,mjs}\" \"scripts/**/*.{ts,mts,mjs,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"shared/**/*.ts\" \"runner/src/**/*.ts\" \"server/**/*.ts\" \"src-web/**/*.{ts,tsx}\" \"tests/**/*.{ts,mts,mjs}\" \"scripts/**/*.{ts,mts,mjs,tsx}\"",
    "icons": "electron scripts/build-icons.mjs",
    "build:chrome-native-host": "node scripts/build-chrome-native-host.mjs",
    "package:local": "node scripts/package-edition.mjs local",
    "package:full": "node scripts/package-edition.mjs full",
    "build:runner": "node scripts/build-runner.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@iarna/toml": "^2.2.5",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@lezer/highlight": "^1.2.5",
    "@xmldom/xmldom": "^0.8.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "^6.0.0",
    "fuse.js": "7.4.0",
    "jszip": "^3.10.2",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.3",
    "mermaid": "^12.0.0",
    "pdfjs-dist": "^6.3.289",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "qrcode": "^1.5.4",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "semver": "^7.8.5",
    "sucrase": "^3.35.1",
    "undici": "^7.30.0",
    "yaml": "2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@openai/codex": "0.149.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.4.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.3",
    "linkedom": "^0.18.12",
    "prettier": "3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "dev.openclaudex.full",
    "afterSign": "./scripts/release/sign-macos.mjs",
    "productName": "Claudex",
    "protocols": [],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/**/*",
      "!backend{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "build/official-ui",
        "to": "official-ui"
      },
      {
        "from": "build/official-usercontent",
        "to": "official-usercontent"
      },
      {
        "from": "build/runtime",
        "to": "codex"
      },
      {
        "from": "build/CODEX-NOTICE.txt",
        "to": "codex/NOTICE.txt"
      },
      {
        "from": "dist-server",
        "to": "provider-service"
      },
      {
        "from": "build/chrome-native-host",
        "to": "chrome-native-host"
      },
      {
        "from": "chrome-extension",
        "to": "chrome-extension"
      },
      {
        "from": "build/icon.iconset/icon_32x32.png",
        "to": "tray-icon.png"
      },
      {
        "from": "build/tray-iconTemplate.png",
        "to": "tray-iconTemplate.png"
      },
      {
        "from": "build/tray-iconTemplate@2x.png",
        "to": "tray-iconTemplate@2x.png"
      },
      {
        "from": "build/icon.iconset/icon_128x128@2x.png",
        "to": "about-icon.png"
      },
      {
        "from": "scripts/configure-backend.mjs",
        "to": "operator/configure-backend.mjs"
      }
    ],
    "asarUnpack": [
      "dist-electron/quick-access-monitor",
      "dist-electron/device-key-mac",
      "dist-electron/notification-authorization.node"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "signIgnore": [
        "/Contents/Resources/official-(ui|usercontent)/",
        "/Resources/[^/]+\\.lproj/locale\\.pak$"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Claudex uses the microphone only while you record a dictation for the message composer."
      },
      "icon": "build/icon.icns"
    },
    "win": {
      "extraResources": [
        {
          "from": "electron/official-ui/native/device-key-win.ps1",
          "to": "device-key-win.ps1"
        }
      ],
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Claudex-Setup-${version}.exe",
      "include": "scripts/release/nsis-installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true,
    "toolsets": {
      "nsis": "1.2.1"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "executableName": "claudex",
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "Claudex <support@zecous.cn>",
      "vendor": "Claudex",
      "synopsis": "Claudex desktop",
      "description": "Claudex desktop app: chat, Cowork and Code.",
      "artifactName": "Claudex-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "Claudex",
          "Keywords": "AI;chat;code;"
        }
      }
    },
    "deb": {
      "artifactName": "claudex_${version}_${arch}.deb",
      "packageName": "claudex"
    },
    "rpm": {
      "artifactName": "claudex-${version}.${arch}.rpm",
      "packageName": "claudex"
    }
  }
}
